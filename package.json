{
  "name": "futbolchi-pro",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine && tsc -p apps/server && tsc -p apps/web",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm -w @futbolchi/web run dev",
    "dev:server": "npm -w @futbolchi/server run dev",
    "build": "npm -w @futbolchi/web run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
