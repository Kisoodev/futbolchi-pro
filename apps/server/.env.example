# Copy to .env (same folder) and fill in. .env is git-ignored.
# Admin panel token: long and secret. The admin panel is off in production without it.
ADMIN_TOKEN=
# Secret nickname that opens the admin login on the name screen.
ADMIN_NICK=admin1121
# Card shown on the payment page.
PAYMENT_CARD_NUMBER=0000 0000 0000 0000
PAYMENT_CARD_HOLDER=KARTA EGASI
# Price in tiyin (500000 = 5 000 so'm).
PERSONA_PRICE_MINOR=500000
# Signs admin payment decisions; required in production.
PAYMENT_EVENT_SECRET=
# Link players can use to message the admin (shown next to the receipt upload).
ADMIN_CONTACT_URL=https://t.me/futproadmin
# Optional admin bot: full token from @BotFather (123456789:AA...). Then send the
# admin token to the bot once to link your chat; TELEGRAM_CHAT_ID may stay empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
